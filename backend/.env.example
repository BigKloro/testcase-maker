# copy to backend/.env
ANTHROPIC_API_KEY=sk-ant-...
# optional
TESTCASE_MAKER_MODEL=claude-opus-5
TESTCASE_MAKER_EFFORT=high
# set to 1 to serve the fixture in tests/fixture_llm_output.json instead of calling Claude (UI dev, demos without a key)
# TESTCASE_MAKER_MOCK=1

# Jira fetch. All three must be set or the feature stays off and the endpoint returns 501.
# Token: id.atlassian.com -> Security -> API tokens -> Create API token
# Leave unset on the public demo so real ticket text never reaches it.
# JIRA_BASE_URL=https://your-site.atlassian.net
# JIRA_EMAIL=you@example.com
# JIRA_API_TOKEN=
